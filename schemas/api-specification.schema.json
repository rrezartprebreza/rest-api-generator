{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://restapigen.dev/schemas/api-specification.schema.json",
  "title": "REST API Generator Specification",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "projectName": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
    "basePackage": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"},
    "securityHint": {"type": "string", "enum": ["none", "jwt", "oauth2", "basic"]},
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entity": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Z][a-zA-Z0-9_]*$"},
              "table": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"},
              "idType": {"type": "string", "enum": ["Long", "UUID", "String"]},
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9_]*$"},
                    "type": {
                      "anyOf": [
                        {"enum": ["String", "Long", "Integer", "Boolean", "BigDecimal", "BigInteger", "Float", "Double", "LocalDate", "LocalDateTime", "Instant", "UUID", "Map<String,Object>", "List<String>", "List<Long>", "List<Integer>", "List<Boolean>", "List<BigDecimal>", "List<Float>", "List<Double>", "List<LocalDate>", "List<LocalDateTime>", "List<Instant>", "List<UUID>"]},
                        {"type": "string", "pattern": "^[A-Z][A-Za-z0-9_]*$"}
                      ]
                    },
                    "validation": {
                      "type": "array",
                      "items": {"type": "string", "pattern": "^(NotBlank|Email|Size:[0-9]+:[0-9]+|(Min|Max):-?[0-9]+|Decimal(Min|Max):-?[0-9]+(\\.[0-9]+)?|OneOf:[A-Za-z0-9_]+(\\|[A-Za-z0-9_]+)*)$"}
                    },
                    "unique": {"type": "boolean"},
                    "nullable": {"type": "boolean"},
                    "min": {"type": ["integer", "null"]},
                    "max": {"type": ["integer", "null"]},
                    "format": {"type": ["string", "null"]},
                    "encrypted": {"type": "boolean"},
                    "enumValues": {"type": "array", "items": {"type": "string"}},
                    "defaultValue": {"type": ["string", "null"]},
                    "calculatedExpression": {"type": ["string", "null"]}
                  },
                  "required": [
                    "name",
                    "type",
                    "validation",
                    "unique",
                    "nullable",
                    "min",
                    "max",
                    "format",
                    "encrypted",
                    "enumValues",
                    "defaultValue",
                    "calculatedExpression"
                  ]
                }
              }
            },
            "required": ["name", "table", "idType", "fields"]
          },
          "api": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "resourcePath": {"type": "string", "pattern": "^/(?:[A-Za-z0-9_-]+/?)*$"},
              "crud": {"type": "boolean"},
              "pagination": {"type": "boolean"},
              "sorting": {"type": "boolean"},
              "customEndpoints": {
                "type": "array",
                "items": {"type": "string", "pattern": "^[a-z][A-Za-z0-9_-]{0,63}$"},
                "uniqueItems": true
              }
            },
            "required": ["resourcePath", "crud", "pagination", "sorting", "customEndpoints"]
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {"type": "string", "enum": ["OneToOne", "OneToMany", "ManyToOne", "ManyToMany"]},
                "target": {"type": "string"},
                "fieldName": {"type": "string"}
              },
              "required": ["type", "target", "fieldName"]
            }
          }
        },
        "required": ["entity", "api", "relationships"]
      }
    },
    "suggestions": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "required": ["projectName", "basePackage", "securityHint", "entities", "suggestions"]
}
